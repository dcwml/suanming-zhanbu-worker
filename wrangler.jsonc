{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suanming-zhanbu-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"] }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
