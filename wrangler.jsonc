{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suanming-zhanbu-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"] }
  ],
  "vars": {
    "LLM_BASE_URL": "https://apihub.agnes-ai.cn",
    "LLM_MODEL": "agnes-2.0-flash"
  },
  "ratelimits": [
    {
      "name": "BAZI_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
